# Server
PORT=3000

# Redis — local: redis://localhost:6379 | Upstash: rediss://...
REDIS_URL=redis://localhost:6379

# PostgreSQL — local or Neon/Render connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/taskscheduler

# Worker heartbeat interval (ms)
HEARTBEAT_INTERVAL=5000

# Monitor check interval (ms)
MONITOR_INTERVAL=10000

# Stale heartbeat threshold (ms) — worker marked DEAD after this
STALE_THRESHOLD=15000

# BullMQ job options
JOB_ATTEMPTS=3
JOB_BACKOFF_DELAY=2000
